# Пример файла переменных окружения для inference сервера
# Скопируйте этот файл в .env и заполните реальными значениями

# Supabase настройки
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Active model id (checkpoint loaded from Blob in production or models/{name}.pt locally)
MODEL_NAME=temp-quick
# Optional legacy override (if set, takes precedence over MODEL_NAME path resolution)
# MODEL_PATH=models/v1.pt

# Настройки сервера
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Логирование
LOG_LEVEL=INFO

# Frontend URL для CORS (можно указать несколько через запятую)
FRONTEND_URL=http://localhost:3000,https://yourdomain.com

BLOB_READ_WRITE_TOKEN=